{
  "realm": "eventcart",
  "enabled": true,
  "displayName": "EventCart",
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Can manage products, inventory, and operational data"
      },
      {
        "name": "CUSTOMER",
        "description": "Can use shopping cart, order, and notification APIs"
      },
      {
        "name": "SUPPORT",
        "description": "Can inspect orders, payments, and notifications"
      }
    ]
  },
  "clients": [
    {
      "clientId": "eventcart-gateway",
      "name": "EventCart Gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:5173/*",
        "http://localhost:4173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:4173",
        "http://localhost:8080",
        "http://localhost:8081",
        "http://localhost:8082",
        "http://localhost:8083",
        "http://localhost:8084",
        "http://localhost:8085",
        "http://localhost:8086"
      ],
      "protocolMappers": [
        {
          "name": "customer-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "customer_id",
            "claim.name": "customer_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "EventCart",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "customer-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "EventCart",
      "lastName": "Customer",
      "attributes": {
        "customer_id": [
          "customer-1"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "customer",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CUSTOMER"
      ]
    },
    {
      "username": "support-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "EventCart",
      "lastName": "Support",
      "credentials": [
        {
          "type": "password",
          "value": "support",
          "temporary": false
        }
      ],
      "realmRoles": [
        "SUPPORT"
      ]
    }
  ]
}
